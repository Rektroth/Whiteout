{
	"schemaVersion": 1,
	"id": "whiteout",
	"version": "${version}",
	"name": "Whiteout",
	"description": "A Fabric implementation of the bug fixes offered by the Paper project.",
	"authors": [
		"Rektroth"
	],
	"contact": {
		"sources": "https://github.com/rektroth/Whiteout"
	},
	"license": "GPLv3",
	"icon": "assets/whiteout/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.rektroth.whiteout.Whiteout"
		]
	},
	"mixins": [
		"whiteout.mixins.json"
	],
	"depends": {
		"fabricloader": "~${fabric_version}",
		"minecraft": "~${mc_version}",
		"java": ">=25"
	},
	"suggests": {
		"lithium": "~${lithium_version}"
	},
	"breaks": {
		"lithium": "<${lithium_version} >=${next_lithium_version}"
	},
	"custom": {
		"loom:injected_interfaces": {
			"net/minecraft/world/entity/boss/enderdragon/EndCrystal": ["io/github/rektroth/whiteout/accessors/GeneratedByDragonFightAccessor"],
			"net/minecraft/world/level/Level": ["io/github/rektroth/whiteout/accessors/CaptureTreeGenerationAccessor"]
		}
	}
}
